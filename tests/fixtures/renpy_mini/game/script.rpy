# Synthetic fixture generated by scripts/make_fixtures.py -- do not edit by hand.
# 3 voiced characters + an unvoiced protagonist, narrator lines, a menu, voice statements and one `voice sustain`.

define s = Character("さくら", color="#c8c8ff", voice_tag="sakura")
define h = Character("陽翔", color="#c8c8ff", voice_tag="haruto")
define y = Character("ゆい", color="#c8c8ff", voice_tag="yui")
define mc = Character("蓮", color="#c8c8ff", voice_tag="hero")

init python:
    config.has_voice = True

label start:
    scene black
    $ renpy.music.set_volume(0.8)
    "放課後の教室。窓の外は夕焼けだった。"
    voice "voice/sak_0001.ogg"
    s "ねえ、陽翔くん。ちょっと待って！"
    voice "voice/har_0001.ogg"
    h "どうしたの、さくら？"
    voice "voice/sak_0002.ogg"
    s "今日はね、すごくいいことがあったの！"
    voice "voice/har_0002.ogg"
    h "へえ、何があったんだ？"
    voice "voice/sak_0003.ogg"
    s "テストで百点を取ったんだよ！"
    voice "voice/yui_0001.ogg"
    y "うそ……本当に？"
    voice "voice/sak_0004.ogg"
    s "本当だよ！ゆいちゃんも見る？"
    "ゆいは少し寂しそうに笑った。"
    voice "voice/yui_0002.ogg"
    y "わたしは……今回もだめだった。"
    voice "voice/har_0003.ogg"
    h "次はきっと大丈夫だよ。"
    mc "……ゆい、大丈夫か？"
    "蓮はゆいにだけ聞こえるよう、小さな声でささやいた。"
    "さくらが胸を張るのを見て、蓮は笑いながら言った。"
    mc "はいはい、百点はすごいよ。さくらは偉い偉い。"
    mc "でも、ゆいだって毎日遅くまで頑張ってたんだぞ。"
    "蓮は悔しさをこらえきれず、泣きながら言った。"
    menu:
        "励ます":
            voice "voice/har_0004.ogg"
            h "一緒に勉強しようか？"
            voice "voice/yui_0003.ogg"
            y "うん！ありがとう！"
        "黙っている":
            voice "voice/har_0005.ogg"
            h "うーん……"
            voice "voice/yui_0004.ogg"
            y "ふん、もういいよ。"
    jump after_menu

label after_menu:
    voice "voice/sak_0005.ogg"
    s "ねえ、三人で帰ろう！"
    voice "voice/har_0006.ogg"
    h "ああ、そうしよう。"
    voice sustain
    h "雨が降りそうだしな。"
    voice "voice/yui_0005.ogg"
    y "あはは、さくらちゃんったら！"
    voice "voice/sak_0006.ogg"
    s "えへへ。"
    "三人は並んで校門を出た。"
    voice "voice/har_0007.ogg"
    h "また明日な。"
    voice "voice/yui_0006.ogg"
    y "また明日ね！"
    voice "voice/sak_0007.ogg"
    s "じゃあね！"
    "校門の前で、三人は手を振って別れた。"

label epilogue:
    "三人の背中が、夕焼けの中へ遠ざかっていく。"
    mc "みんな、帰ったのか。"
    "教室には蓮ひとりだけが残った。"
    "黒板の上の時計が、静かに時を刻んでいる。"
    "机の上には、さくらの忘れ物のノートが置かれていた。"
    mc "おい、さくら、ノートを忘れてるぞ！"
    "蓮は廊下に飛び出して、待ってくれと叫んだ。"
    "返事がないので、蓮は腹立ちまぎれに怒鳴った。"
    mc "もういい、明日渡すからな！"
    with dissolve
    return


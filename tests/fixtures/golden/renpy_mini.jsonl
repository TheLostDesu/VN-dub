{"line_id":"start_000001","scene":"start","speaker_raw":"","speaker_id":"narrator","text_src":"放課後の教室。窓の外は夕焼けだった。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000002","scene":"start","speaker_raw":"さくら","speaker_id":"sakura","text_src":"ねえ、陽翔くん。ちょっと待って！","voice_file":"voice/sak_0001.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000003","scene":"start","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"どうしたの、さくら？","voice_file":"voice/har_0001.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000004","scene":"start","speaker_raw":"さくら","speaker_id":"sakura","text_src":"今日はね、すごくいいことがあったの！","voice_file":"voice/sak_0002.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000005","scene":"start","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"へえ、何があったんだ？","voice_file":"voice/har_0002.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000006","scene":"start","speaker_raw":"さくら","speaker_id":"sakura","text_src":"テストで百点を取ったんだよ！","voice_file":"voice/sak_0003.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000007","scene":"start","speaker_raw":"ゆい","speaker_id":"yui","text_src":"うそ……本当に？","voice_file":"voice/yui_0001.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000008","scene":"start","speaker_raw":"さくら","speaker_id":"sakura","text_src":"本当だよ！ゆいちゃんも見る？","voice_file":"voice/sak_0004.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000009","scene":"start","speaker_raw":"","speaker_id":"narrator","text_src":"ゆいは少し寂しそうに笑った。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000010","scene":"start","speaker_raw":"ゆい","speaker_id":"yui","text_src":"わたしは……今回もだめだった。","voice_file":"voice/yui_0002.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000011","scene":"start","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"次はきっと大丈夫だよ。","voice_file":"voice/har_0003.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000012","scene":"start","speaker_raw":"蓮","speaker_id":"hero","text_src":"……ゆい、大丈夫か？","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000013","scene":"start","speaker_raw":"","speaker_id":"narrator","text_src":"蓮はゆいにだけ聞こえるよう、小さな声でささやいた。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000014","scene":"start","speaker_raw":"","speaker_id":"narrator","text_src":"さくらが胸を張るのを見て、蓮は笑いながら言った。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000015","scene":"start","speaker_raw":"蓮","speaker_id":"hero","text_src":"はいはい、百点はすごいよ。さくらは偉い偉い。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000016","scene":"start","speaker_raw":"蓮","speaker_id":"hero","text_src":"でも、ゆいだって毎日遅くまで頑張ってたんだぞ。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000017","scene":"start","speaker_raw":"","speaker_id":"narrator","text_src":"蓮は悔しさをこらえきれず、泣きながら言った。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"start_000018","scene":"start","speaker_raw":"","speaker_id":"narrator","text_src":"","voice_file":null,"has_voice":false,"flags":["menu"],"choices":["励ます","黙っている"]}
{"line_id":"start_000019","scene":"start","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"一緒に勉強しようか？","voice_file":"voice/har_0004.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000020","scene":"start","speaker_raw":"ゆい","speaker_id":"yui","text_src":"うん！ありがとう！","voice_file":"voice/yui_0003.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000021","scene":"start","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"うーん……","voice_file":"voice/har_0005.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"start_000022","scene":"start","speaker_raw":"ゆい","speaker_id":"yui","text_src":"ふん、もういいよ。","voice_file":"voice/yui_0004.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000001","scene":"after_menu","speaker_raw":"さくら","speaker_id":"sakura","text_src":"ねえ、三人で帰ろう！","voice_file":"voice/sak_0005.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000002","scene":"after_menu","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"ああ、そうしよう。","voice_file":"voice/har_0006.ogg","has_voice":true,"flags":["sustain_head"],"choices":null}
{"line_id":"after_menu_000003","scene":"after_menu","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"雨が降りそうだしな。","voice_file":null,"has_voice":false,"flags":["voice_sustain"],"choices":null}
{"line_id":"after_menu_000004","scene":"after_menu","speaker_raw":"ゆい","speaker_id":"yui","text_src":"あはは、さくらちゃんったら！","voice_file":"voice/yui_0005.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000005","scene":"after_menu","speaker_raw":"さくら","speaker_id":"sakura","text_src":"えへへ。","voice_file":"voice/sak_0006.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000006","scene":"after_menu","speaker_raw":"","speaker_id":"narrator","text_src":"三人は並んで校門を出た。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"after_menu_000007","scene":"after_menu","speaker_raw":"陽翔","speaker_id":"haruto","text_src":"また明日な。","voice_file":"voice/har_0007.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000008","scene":"after_menu","speaker_raw":"ゆい","speaker_id":"yui","text_src":"また明日ね！","voice_file":"voice/yui_0006.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000009","scene":"after_menu","speaker_raw":"さくら","speaker_id":"sakura","text_src":"じゃあね！","voice_file":"voice/sak_0007.ogg","has_voice":true,"flags":[],"choices":null}
{"line_id":"after_menu_000010","scene":"after_menu","speaker_raw":"","speaker_id":"narrator","text_src":"校門の前で、三人は手を振って別れた。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000001","scene":"epilogue","speaker_raw":"","speaker_id":"narrator","text_src":"三人の背中が、夕焼けの中へ遠ざかっていく。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000002","scene":"epilogue","speaker_raw":"蓮","speaker_id":"hero","text_src":"みんな、帰ったのか。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000003","scene":"epilogue","speaker_raw":"","speaker_id":"narrator","text_src":"教室には蓮ひとりだけが残った。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000004","scene":"epilogue","speaker_raw":"","speaker_id":"narrator","text_src":"黒板の上の時計が、静かに時を刻んでいる。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000005","scene":"epilogue","speaker_raw":"","speaker_id":"narrator","text_src":"机の上には、さくらの忘れ物のノートが置かれていた。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000006","scene":"epilogue","speaker_raw":"蓮","speaker_id":"hero","text_src":"おい、さくら、ノートを忘れてるぞ！","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000007","scene":"epilogue","speaker_raw":"","speaker_id":"narrator","text_src":"蓮は廊下に飛び出して、待ってくれと叫んだ。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000008","scene":"epilogue","speaker_raw":"","speaker_id":"narrator","text_src":"返事がないので、蓮は腹立ちまぎれに怒鳴った。","voice_file":null,"has_voice":false,"flags":[],"choices":null}
{"line_id":"epilogue_000009","scene":"epilogue","speaker_raw":"蓮","speaker_id":"hero","text_src":"もういい、明日渡すからな！","voice_file":null,"has_voice":false,"flags":[],"choices":null}
